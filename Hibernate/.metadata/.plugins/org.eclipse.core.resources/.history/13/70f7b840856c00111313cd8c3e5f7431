package com.tca.entities;

import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.OneToOne;
import jakarta.persistence.Table;

@Entity
@Table(name="engine")
public class Engine {

	@Id
	private Integer eid;
	private String type;
	private String size;
	

	@OneToOne(mappedBy="engine")
	private Car car;
}
